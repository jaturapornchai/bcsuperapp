# Server
PORT=8095
RUST_LOG=info

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27029
MONGODB_DB=bcapp

# MinIO Object Storage
MINIO_ENDPOINT=http://127.0.0.1:9120
MINIO_ACCESS_KEY=bcappadmin
MINIO_SECRET_KEY=bcapp_minio_local_dev
MINIO_BUCKET=bcapp-storage

# Auth & Google OAuth2
JWT_SECRET=replace_with_your_32_char_secret_key_in_local_env
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SUPER_ADMIN_EMAIL=admin@example.com

# DeepSeek AI Brain (Enterprise Assistant)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Push alerts (Firebase Cloud Messaging) — leave empty to keep push off.
# Path to the service-account JSON from Firebase console (keep it out of git,
# e.g. backend/secrets/). Web push also needs the 4 public web values below.
FCM_SERVICE_ACCOUNT_FILE=
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_WEB_SENDER_ID=
FCM_WEB_VAPID_KEY=
